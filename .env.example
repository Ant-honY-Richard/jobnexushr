# Postgres connection string (required for /contact, /jobs, /jobs/[id], /api/health)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public site URL used for canonical/OG URLs, sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=https://www.example.com

# EmailJS — form submissions are emailed to anthonyrichard@jobnexushr.com (see EMAILJS-SETUP.md)
# Public by design (EmailJS keys run in the browser); restrict the domain in the EmailJS dashboard.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
